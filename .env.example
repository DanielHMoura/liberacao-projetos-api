# ====================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ====================================

# Host do PostgreSQL (Neon.tech)
# Exemplo: ep-cool-darkness-123456.us-east-2.aws.neon.tech
DB_HOST=seu-host.neon.tech

# Porta do PostgreSQL (geralmente 5432)
DB_PORT=5432

# Nome do banco de dados
DB_NAME=liberacao_projetos

# Usuário do banco de dados
DB_USER=seu_usuario

# Senha do banco de dados
DB_PASSWORD=sua_senha_super_segura


# ====================================
# CONFIGURAÇÃO DO SUPABASE STORAGE
# ====================================

# URL do projeto Supabase
# Exemplo: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave da API do Supabase (anon/public key)
# Encontrada em: Settings > API > Project API keys
SUPABASE_KEY=sua_chave_supabase_aqui

# Nome do bucket no Supabase Storage
# Deve ser criado manualmente no painel do Supabase
SUPABASE_BUCKET=projetos-pdfs


# ====================================
# CONFIGURAÇÃO DO SERVIDOR
# ====================================

# Porta do servidor (8080 é padrão para Spring Boot)
SERVER_PORT=8080

# Ambiente (development, production)
SPRING_PROFILES_ACTIVE=development


# ====================================
# CONFIGURAÇÕES OPCIONAIS
# ====================================

# Nível de log
LOGGING_LEVEL=INFO

# Exibir SQL no console (true/false)
SHOW_SQL=false

# Tamanho máximo de upload (em MB)
MAX_FILE_SIZE=50

# Habilitar CORS (true/false)
CORS_ENABLED=true

# Origem permitida para CORS (em produção, especifique domínios)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080


# ====================================
# INSTRUÇÕES
# ====================================

# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha as variáveis com suas credenciais reais
# 3. NUNCA commit o arquivo .env no Git
# 4. Adicione .env ao .gitignore
